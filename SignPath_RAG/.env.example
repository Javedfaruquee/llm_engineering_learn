# Copy to .env and fill in. Only OPENAI_API_KEY is required; everything else has a working default.
# A value here wins over the same variable in the process environment. Docker Compose passes this file into the
# container (except SIGNPATH_DATA_DIR and the server address, which are fixed there).
OPENAI_API_KEY=sk-...

# --- Exposure (there are no logins: see README "Access and exposure") ---
# SIGNPATH_BIND=127.0.0.1                # Docker only: host address the port is published on (0.0.0.0 = all)
# SIGNPATH_PORT=7860                     # Docker only: host port
# SIGNPATH_USER_HEADER=X-Forwarded-User  # optional: reverse proxy header that identifies clients in log/limits

# --- Abuse and spend limits ---
# SIGNPATH_RATE_PER_MINUTE=10            # questions per user per minute; 0 = no limit
# SIGNPATH_DAILY_LIMIT=2000              # questions per day, all users together; 0 = no limit
# SIGNPATH_CONCURRENCY=4                 # questions answered at the same time; the rest queue

# --- Question log and cost display ---
# SIGNPATH_LOG_QUESTIONS=1               # log questions, answers, tokens and feedback to signpath_data/logs
# SIGNPATH_LOG_RETENTION_DAYS=30         # 0 = keep forever
# SIGNPATH_SHOW_COST=1                   # token/cost/latency line under each answer
# SIGNPATH_PRICES={"gpt-4.1-mini": [0.40, 1.60]}   # USD per 1M input/output tokens, overrides built-in list prices

# --- Data and refresh ---
# SIGNPATH_DATA_DIR=/srv/signpath-data   # default: signpath_data/ next to the scripts
# SIGNPATH_REFRESH_HOURS=360             # background re-crawl interval; 0 = off
# SIGNPATH_QUALITY_GATE=1                # score a refreshed index before it goes live; 0 = promote unchecked

# --- Models and OpenAI ---
# SIGNPATH_LLM_MODEL=gpt-4.1-mini
# SIGNPATH_JUDGE_MODEL=gpt-4.1           # grades answers in --eval-answers
# SIGNPATH_OPENAI_TIMEOUT=60             # seconds per request
# SIGNPATH_OPENAI_RETRIES=3

# --- Server and logging (native) ---
# SIGNPATH_OPEN_BROWSER=1
# GRADIO_SERVER_NAME=127.0.0.1           # 0.0.0.0 to listen on all interfaces
# GRADIO_SERVER_PORT=7860
# SIGNPATH_UI_UPDATE_SECONDS=0.15
# SIGNPATH_LOG_LEVEL=INFO
